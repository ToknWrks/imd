# ── Signer (pick one; interactive path is Connect wallet + smart account) ────
#
# Recommended setup: leave SMART_ACCOUNT_ACTIVE=true. The header Connect-wallet
# button (wallet-connect.js) records the funding wallet's ADDRESS only — keys
# never leave the browser extension. The smart wallet below signs all trades.

# Alchemy smart account (ERC-4337) — the default/interactive signer path.
# MultiOwnerLightAccount (Alchemy Account Kit, EntryPoint 0.7); owned by the
# burner "session key" that signs all UserOperations. Same key → same account
# address, always. Back it up like a seed phrase.
# Generate in the dashboard (Settings → Smart wallet) or:
#   node scripts/setup-smart-account.mjs
SMART_ACCOUNT_ACTIVE=false
AA_SESSION_KEY=

# CONNECTED_WALLET — address-only record of the header Connect-wallet session
# (no key material). Written by the dashboard when you connect; read by the
# balances API (connected wallet first, legacy signer fallback) and used as
# the default sweep target. No need to hand-edit.
# CONNECTED_WALLET=0x...

# Raw private key (0x-prefixed). Legacy — headless/VPS-CLI setups only.
AGENT_PRIVATE_KEY=0x...

# OR use a VultiSig MPC vault instead of a raw key (see /settings to create/import one)
VAULT_ACTIVE=false
VULT_FILE_PATH=./data/vault.vult
VULTISIG_PASS=

# Optional DEDICATED hot wallet for the Market Maker bot (/mm tab). Its ETH and
# token inventory stay fully segregated from the dip strategies. Leave unset to
# have the MM bot share the main signer. Settable from the Settings tab.
MM_PRIVATE_KEY=

# ── RPC / data ────────────────────────────────────────────────────

# Alchemy API key — required. WebSocket Swap-event subscriptions (dip watcher),
# AA bundler/paymaster, wallet-position transfer scans, Base + Robinhood (4663)
# HTTP RPC for the Sniper/diagnostics. Enable each network on your Alchemy app.
ALCHEMY_API_KEY=

# ── Trading mode ──────────────────────────────────────────────────

# Co-pilot mode: every trade (dip, sniper, MM) waits for explicit approval in
# the dashboard — the connected browser wallet signs it; anything not approved
# within the timeout is skipped and logged, never traded. Requires
# CONNECTED_WALLET (header Connect-wallet button) and an open dashboard tab.
# Leave false for full autonomy via the signers configured above.
COPILOT_ACTIVE=false
# Approval window in seconds (default 90; minimum 10)
# COPILOT_TIMEOUT_S=90

# ── Optional ─────────────────────────────────────────────────────

# Venice API key (OpenAI-compatible endpoint api.venice.ai) — Zooch AI planner
# + narrative generation. Without it, Zooch falls back to deterministic
# heuristics (review badged "heuristic fallback" instead of "AI-planned").
# Settable from the Settings tab; the model default lives in code (dashboard
# falls back to "openai-gpt-4o-mini-2024-07-18" when unset — set OPENAI_MODEL
# to a Venice model id, e.g. a "stealth" model).
OPENAI_API_KEY=
# OPENAI_MODEL=

# Uniswap Trading API key (developers.uniswap.org/dashboard) — optional
# cross-pool smart routing (V2/V3/V4) via trade-api.gateway.uniswap.org.
UNISWAP_API_KEY=

# The Graph Studio key (thegraph.com/studio/apikeys) — optional; per-trade
# swap history for Zooch (72h p50/p90/p95/max sell sizes per venue).
# NOTE: a Uniswap dashboard key is NOT a Graph key — the gateway rejects it
# with "malformed API key". They are different platforms.
THEGRAPH_API_KEY=

# Dashboard port (default: 4200)
# DASHBOARD_PORT=4200

# ── WS watchdog (dip-watcher) ─────────────────────────────────────

# Proves WebSocket liveness with a newHeads probe every WATCHDOG_PROBE_S; a
# chain with no block heads within 3 block-times gets its socket client closed
# and all subscriptions rebuilt (alerting via Telegram when configured).
# WATCHDOG_PROBE_S=120            # probe interval (floor 15)
# WATCHDOG_STALL_BLOCKS=5         # consecutive missing blocks = stall
# WATCHDOG_REBUILD_COOLDOWN_S=120 # min seconds between rebuilds

# ── Alerts (notify.mjs) ───────────────────────────────────────────

# Telegram push for operational failures (WS stall/rebuild, trade errors,
# low gas). Both keys required; without them alerts go to pm2 logs only.
# Create a bot via @BotFather; chat id via @userinfobot or the getUpdates API.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# ALERT_DEDUPE_MS=600000          # same-alert suppression window

# ── Auth (wallet-signature gate) ──────────────────────────────────

# The ONE wallet allowed to sign into the dashboard. Login = connect + sign a
# one-time nonce (SIWE-style personal_sign); no password exists. Falls back to
# CONNECTED_WALLET when unset. SET THIS BEFORE HOSTING — with neither set, any
# wallet can log in.
# ALLOWED_WALLET=0x...
