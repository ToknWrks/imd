# ── Signer (pick one) ───────────────────────────────────────────────────────

# Your EVM private key (0x-prefixed). Never leaves your machine.
# Required for Base sniper buys (vault signing is Ethereum-only today).
AGENT_PRIVATE_KEY=0x...

# OR use a VultiSig MPC vault instead of a raw key (see /settings to create/import one)
VAULT_ACTIVE=false
VULT_FILE_PATH=./data/vault.vult
VULTISIG_PASS=

# OR use an Alchemy smart account (ERC-4337) — the VPS-deployment mode.
# Generates a burner "session key" that signs UserOperations; the account
# address is derived from it (Phase 1: burner-owned, cap by funding discipline;
# Phase 2 adds the on-chain SessionKeyPlugin spend caps — see
# docs/smart-account-signer.md). Setup: node scripts/setup-smart-account.mjs
SMART_ACCOUNT_ACTIVE=false
AA_SESSION_KEY=

# Optional DEDICATED hot wallet for the Market Maker bot (/mm tab). Its ETH and
# token inventory stay fully segregated from the dip strategies. Leave unset to
# have the MM bot share AGENT_PRIVATE_KEY. Settable from the Settings tab.
MM_PRIVATE_KEY=

# ── RPC ───────────────────────────────────────────────────────────

# Alchemy API key — required for the WebSocket subscription that watches
# Uniswap pool Swap events in real time (mainnet). Also used for Base HTTP
# on the Sniper page.
ALCHEMY_API_KEY=

# ── Optional ─────────────────────────────────────────────────────

# Dashboard port (default: 4200)
# DASHBOARD_PORT=4200
